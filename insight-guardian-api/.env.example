# PostgreSQL Database Configuration
# Use these variables for docker-compose
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=insights_db

# Use this for local development without Docker and for Alembic
DATABASE_URL="postgresql://user:password@localhost/insights_db"

# OpenAI API Configuration
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="gpt-3.5-turbo"
